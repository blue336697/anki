        <mxCell id="va" value="虚拟地址&#xa;页号 | 页内偏移" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
