<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Copy-On-Write">
    <mxGraphModel dx="900" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="500">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Copy-On-Write (写时拷贝) -- fork() 后父子进程共享物理页" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Parent -->
        <mxCell id="parent" value="父进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="child" value="子进程&#xa;(fork后)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="90" height="50" as="geometry" />
        </mxCell>

        <!-- Page table entries -->
        <mxCell id="pte_parent" value="父进程页表&#xa;虚拟页→物理页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="170" y="55" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pte_child" value="子进程页表&#xa;(fork后复制父页表)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="170" y="195" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- Shared physical pages - step 1 -->
        <mxCell id="phys_shared" value="物理页 A&#xa;(只读标记)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="55" width="100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="label1" value="① fork: 父子共享物理页，标记为只读" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="115" width="180" height="15" as="geometry" />
        </mxCell>

        <!-- After write - step 2 -->
        <mxCell id="step2_title" value="② 父进程写入 → Page Fault → 内核复制页" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="310" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="phys_parent" value="物理页 A&#xa;(可读写)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="350" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="phys_child_copy" value="物理页 A'&#xa;(复制品, 可读写)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="410" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Arrows step 1 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="parent" target="pte_parent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="child" target="pte_child">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="pte_parent" target="phys_shared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="pte_child" target="phys_shared">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows step 2 -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.3;" edge="1" parent="1" source="pte_parent" target="phys_parent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="65" />
              <mxPoint x="320" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.8;entryX=0;entryY=0.7;" edge="1" parent="1" source="pte_child" target="phys_child_copy">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="240" />
              <mxPoint x="320" y="435" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Key points -->
        <mxCell id="key_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=50;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="270" height="135" as="geometry" />
        </mxCell>
        <mxCell id="key_title" value="关键要点" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="345" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="key_items" value="• fork()后父子共享物理页&#xa;• 页表条目标记为只读(写保护)&#xa;• 任一方写入 → Page Fault&#xa;• 内核复制该物理页 → 改为可读写&#xa;• 避免fork后立即复制所有内存&#xa;• fork + exec 场景尤其高效" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="365" width="250" height="105" as="geometry" />
        </mxCell>

        <!-- Performance note -->
        <mxCell id="perf_note" value="Minor Fault: 仅标记页表  |  Major Fault: 需读磁盘  |  COW Fault: 复制物理页" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#d79b00;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="460" width="480" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
